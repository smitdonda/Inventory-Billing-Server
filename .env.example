# Port the API listens on
PORT=5000

# MongoDB connection string
MONGO_DB_URL=mongodb+srv://user:password@cluster.mongodb.net/inventory-billing

# Long random string — sign your own, never reuse the sample
JWT_SECRET=change-me-to-a-long-random-string

# Session length: 7d, 24h, 30m ... (falls back to 7d when unset)
JWT_EXPIRATION_TIME=7d

# Comma-separated allowlist of browser origins. Leave unset to allow any origin.
# CORS_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app
