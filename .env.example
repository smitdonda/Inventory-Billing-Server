# Port the API listens on
PORT=5000

# MongoDB connection string
MONGO_DB_URL=mongodb+srv://user:password@cluster.mongodb.net/inventory-billing

# Connections per serverless instance. Small on purpose: many lambdas each
# holding a large pool is how an Atlas connection quota gets exhausted.
MONGO_POOL_SIZE=5
# Give up on an unreachable cluster instead of hanging the request.
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000

# Long random string — sign your own, never reuse the sample
JWT_SECRET=change-me-to-a-long-random-string

# Session length: 7d, 24h, 30m ... (falls back to 7d when unset)
JWT_EXPIRATION_TIME=7d

# --- Session cookie -------------------------------------------------------
# The token lives in an httpOnly cookie; no script can read it.
#
# Recommended deployment: the frontend rewrites /api to this server, so the
# cookie is first-party and the defaults below are correct as they stand.
#
# If instead the frontend sits on a different domain to this API, the cookie is
# third-party and needs:
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true
# plus the frontend's origin in CORS_ORIGIN. Be aware that Safari and Chrome
# restrict third-party cookies, so that setup can stop working in browsers you
# do not control. Prefer the proxy.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com

# --- CORS -----------------------------------------------------------------
# Comma-separated allowlist of browser origins. An empty list refuses every
# cross-origin browser request, which is what you want when the frontend
# proxies /api to this server. Outside production, http://localhost:3000 is
# allowed automatically for the CRA dev server.
# CORS_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app
